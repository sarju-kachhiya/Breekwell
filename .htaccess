# Enable rewrite engine
RewriteEngine On

# --------------------------------------------------------
# 1. Redirect *.html requests to extensionless URLs
#    e.g. /terms.html  →  /terms
# --------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# --------------------------------------------------------
# 2. Internally serve .html when clean URL is requested
#    e.g. /terms  →  /terms.html
# --------------------------------------------------------
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]
